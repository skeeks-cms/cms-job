{
    "name": "skeeks/cms-job",
    "description": "Universal background jobs, queue and run history for SkeekS CMS",
    "keywords": ["yii", "skeeks", "framework", "component", "job", "queue"],
    "homepage": "https://cms.skeeks.com/",
    "type": "yii2-extension",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://skeeks.com/",
        "wiki": "https://cms.skeeks.com/docs/",
        "source": "https://github.com/skeeks-cms/cms-job"
    },
    "authors": [
        {
            "name": "Semenov Alexander",
            "email": "semenov@skeeks.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "skeeks/cms": "*"
    },
    "autoload": {
        "psr-4": {
            "skeeks\\cms\\job\\": "src/"
        }
    },
    "extra": {
        "config-plugin": {
            "console": [
                "src/config/common.php",
                "src/config/console.php"
            ],
            "web": [
                "src/config/common.php",
                "src/config/web.php"
            ]
        }
    }
}
